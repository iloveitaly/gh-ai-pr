#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "git-history-extraction>=0.11.1",
# ]
# ///

import subprocess
import sys
import json
from pathlib import Path
from git_history_extraction import extract_history

DEFAULT_TEMPLATE = """## Motivation

<!-- why we are making this change -->

## Description

<!-- the change that was made and why we took this approach -->

## Test

<!--
- very short, concise summary on what tests were added to test the changes in this PR
- always include all testing details here, and not in `Description`, unless the entire PR is changes to the test suite. If that's the case, omit this section.
- if we are changing the design, link to a dev environment or screenshot describing the change
-->

## Links

<!-- link(s) to any external documentation, issues, chat conversations, etc about this change -->
"""

def run_command(cmd, silent=False):
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        if not silent:
            print(f"Error running command {' '.join(cmd)}: {e}", file=sys.stderr)
        return None

def get_base_branch():
    # 1. Try to get default branch from gh cli (requires remote)
    base = run_command(["gh", "repo", "view", "--json", "defaultBranchRef", "--jq", ".defaultBranchRef.name"], silent=True)
    if base:
        return base

    # 2. Try to get the remote default branch via git
    remote_head = run_command(["git", "symbolic-ref", "refs/remotes/origin/HEAD", "--short"], silent=True)
    if remote_head:
        return remote_head.split('/')[-1]

    # 3. Fallback to checking local branches
    branches = run_command(["git", "branch", "--list", "main", "master"], silent=True)
    if branches:
        if "main" in branches:
            return "main"
        if "master" in branches:
            return "master"

    return "main"

def get_current_branch():
    return run_command(["git", "rev-parse", "--abbrev-ref", "HEAD"])

def get_repo_root():
    return run_command(["git", "rev-parse", "--show-toplevel"])

def get_history(branch=None):
    # Use the library to get history. This will return a list of dicts.
    # git-history-extraction requires the exact repo root (it does not
    # search parent directories), so resolve it explicitly in case we're
    # invoked from a subdirectory of the repo.
    repo_root = get_repo_root() or "."
    commits = extract_history(
        repo_path=repo_root,
        branch=branch,
        include_stats=True
    )
    return json.dumps(commits, indent=2)

def find_pr_template():
    search_paths = [
        Path(".github/PULL_REQUEST_TEMPLATE.md"),
        Path(".github/pull_request_template.md"),
        Path("PULL_REQUEST_TEMPLATE.md"),
        Path("pull_request_template.md"),
        Path(".github/PULL_REQUEST_TEMPLATE/default.md")
    ]
    for path in search_paths:
        if path.exists() and path.is_file():
            return path.read_text()
    
    template_dir = Path(".github/PULL_REQUEST_TEMPLATE")
    if template_dir.is_dir():
        for template_file in template_dir.glob("*.md"):
            return template_file.read_text()
                
    return None

def main():
    base = get_base_branch()
    current = get_current_branch()
    
    if not current:
        print("Error: Could not determine current branch.", file=sys.stderr)
        sys.exit(1)

    if current in [base, "main", "master"]:
        print(f"Error: You are on the default branch ({current}). Please switch to a unique feature branch to generate a PR description.", file=sys.stderr)
        sys.exit(1)
    
    # We use the git-history-extraction tool for the current feature branch
    history_json = get_history(branch=current)
    
    if not history_json:
        print("Error: Failed to extract git history using git-history-extraction.", file=sys.stderr)
        sys.exit(1)

    repo_template = find_pr_template()
    if repo_template:
        template = repo_template
        template_type = "repository's pull request template"
    else:
        template = DEFAULT_TEMPLATE
        template_type = "fallback pull request template"
    
    prompt = f"""Generate a pull request description based on the following context.

<git_history>
{history_json}
</git_history>

<{template_type.replace(' ', '_')}>
{template}
</{template_type.replace(' ', '_')}>

<task>
Provide a title for the pull request and a description following the fallback pull request template provided above.
</task>

<title_rules>
The title should be in a conventional commit format.
</title_rules>
<description_rules>
- Be extremely clear, direct, and concise (1-2 sentences max for Motivation). No emojis.
- Bullet lists are fine, but don't bold the start of each bullet.
- Focus on "why" the changes were made and "how" they achieve the goal, rather than a line-by-line description of "what" was changed.
- Avoid unnecessary adjectives or salesy language.
- Omit the `## Links` section entirely if there are no related issues or links to include.
- Omit the `## Test` section entirely if the pull request only contains documentation updates.
- Unless `<git_history>` is completely focused on the test suite, do not include information about test changes in the `## Description` section.
- If you have access to GitHub search tools (e.g., via MCP), search the repository for any issues mentioned or related to these changes. Include 'Fixes #X' or 'Relates to #X' in the pull request description if appropriate.
- If you are unsure of the correct scope or semantic commit type, take a look at past commits from a PR
- If something was not done, no need to indicate it unless it's very significant. i.e. do not include 'No automated tests added'
- When you are asked to create the PR, use `git push -u origin HEAD && gh pr create --head "$(git branch --show-current)" ...`. Sometimes `fork` is the right remote if we don't have write access to `origin`
</description_rules>
"""
    
    print(prompt)

if __name__ == "__main__":
    main()
